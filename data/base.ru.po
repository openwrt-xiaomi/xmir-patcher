# ==== BE7000 / MiWiFi 1.1.38 — добавлено =====================

msgid "Wi-Fi模式切换"
msgstr "Переключение режима Wi-Fi"

msgid "双频模式"
msgstr "Двухдиапазонный режим"

msgid "三频模式"
msgstr "Трёхдиапазонный режим"

msgid "工作模式"
msgstr "Рабочий режим"

msgid "双频模式：具有更好的覆盖能力，适合大部分的应用场景。"
msgstr "Двухдиапазонный режим: лучшее покрытие, подходит для большинства сценариев."

msgid "三频模式：覆盖弱于双频。可支持WiFi7手机双5G MLO并联，大幅提升带宽。同时可作为独立电竞频段，减少其他设备干扰。"
msgstr "Трёхдиапазонный режим: покрытие слабее, чем у двухдиапазонного. Поддерживает объединение двух диапазонов 5 ГГц по MLO для телефонов с Wi-Fi 7, значительно повышая пропускную способность. Также может использоваться как отдельный игровой диапазон, снижая помехи от других устройств."

msgid "三频模式覆盖明显弱于双频模式，该修改会导致路由器重启，所有设备会短暂失去连接，是否确认修改？"
msgstr "Покрытие в трёхдиапазонном режиме заметно слабее, чем в двухдиапазонном. Изменение приведёт к перезагрузке роутера, все устройства ненадолго потеряют связь. Подтвердить изменение?"

msgid "MLO设置"
msgstr "Настройки MLO"

msgid "多频合一情况下，此路由器会默认开启MLO多链路连接，由Wi-Fi7终端自主选择并发频段接入，提高速率降低延迟。"
msgstr "При объединении диапазонов роутер по умолчанию включает многоканальное соединение MLO: устройства с Wi-Fi 7 сами выбирают диапазоны для одновременного подключения, что повышает скорость и снижает задержку."

msgid "关闭MLO多链路加速将会重启Wi-Fi模块，此期间所有接入此路由器的设备都会断开Wi-Fi连接，请确认是否继续。"
msgstr "Отключение многоканального ускорения MLO перезапустит модуль Wi-Fi: на это время все подключённые устройства потеряют связь. Продолжить?"

msgid "检测到未启用Wi-Fi多频合一，无法打开MLO开关。"
msgstr "Объединение диапазонов Wi-Fi не включено — переключатель MLO недоступен."

msgid "注：检测到未开启Wi-Fi多频合一，无法打开MLO开关。"
msgstr "Примечание: объединение диапазонов Wi-Fi не включено — переключатель MLO недоступен."

msgid "注：检测到已开启Wi-Fi5兼容模式，无法打开MLO开关。"
msgstr "Примечание: включён режим совместимости с Wi-Fi 5 — переключатель MLO недоступен."

msgid "注：检测到已开启Wi-Fi5兼容模式，无法打开TWT开关。"
msgstr "Примечание: включён режим совместимости с Wi-Fi 5 — переключатель TWT недоступен."

msgid "Wi-Fi多频合一"
msgstr "Объединение диапазонов Wi-Fi"

msgid "Wi-Fi 5 兼容模式"
msgstr "Режим совместимости с Wi-Fi 5"

msgid "TWT节能模式"
msgstr "Режим энергосбережения TWT"

msgid "TWT节能模式兼容性问题解决办法"
msgstr "Решение проблем совместимости режима энергосбережения TWT"

msgid "开启TWT节能模式后，可通过TWT节能技术降低接入此路由器的Wi-Fi6终端设备功耗，部分老旧终端可能会有兼容性问题。"
msgstr "Режим энергосбережения TWT снижает энергопотребление подключённых устройств с Wi-Fi 6. У некоторых старых устройств возможны проблемы совместимости."

msgid "某些老设备对Wi-Fi6协议支持不好，可能扫描不到信号或者连接不上等。开启此开关后，将会切换到Wi-Fi5模式，解决兼容问题。但同时会关闭Wi-Fi6的相关功能，如OFDMA、TWT、BSS Coloring等。"
msgstr "Некоторые старые устройства плохо поддерживают Wi-Fi 6: могут не видеть сеть или не подключаться. Этот переключатель переводит роутер в режим Wi-Fi 5 и решает проблемы совместимости, но отключает функции Wi-Fi 6 — OFDMA, TWT, BSS Coloring и другие."

msgid "异信道部署"
msgstr "Разнесение каналов"

msgid "启用异信道部署后，2.4G无线信道将根据环境内信道占用情况，自动调整设备的信道分布，避开拥塞，如需采用自动信道或固定信道，请先关闭功能"
msgstr "При включённом разнесении каналов роутер автоматически распределяет каналы 2,4 ГГц с учётом загруженности эфира, избегая перегруженных. Для выбора автоматического или фиксированного канала сначала отключите эту функцию"

msgid "MU-MIMO“多用户多入多出”技术，可以让路由器与多台终端同时通信，极大改善无线资源利用效率，提升Wi-Fi体验。该功能生效需要路由器和终端同时支持。"
msgstr "MU-MIMO («многопользовательский вход-выход») позволяет роутеру обмениваться данными сразу с несколькими устройствами, заметно повышая эффективность использования эфира. Требуется поддержка и роутером, и устройством."

msgid "静默模式"
msgstr "Бесшумный режим"

msgid "开启此功能，路由将关闭所有Wi-Fi功能。 *路由器重启后，该模式将自动关闭，Wi-Fi将自动打开。"
